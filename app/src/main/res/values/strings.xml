    <!-- On-device banner (shown across Onboarding, Home, Editor, Export) -->
    <string name="on_device_banner_title">Runs entirely on your phone</string>
    <string name="on_device_banner_body">Transcription, translation, and caption burn-in all happen on-device — nothing is ever uploaded. On older or slower phones this can take several minutes. You can leave the app; it keeps working in the background and a notification shows progress.</string>
    <string name="on_device_banner_short">Everything runs on-device. It may be slow on older phones, and keeps working in the background.</string>
    <string name="on_device_banner_dismiss">Dismiss</string>

    <!-- Low-end device warning (shown only on genuinely weak hardware) -->
    <string name="low_end_title">This phone may be slow</string>
    <string name="low_end_body">Your device is on the lower-powered side for on-device AI. Captioning runs on its processor — there\'s no dedicated graphics acceleration here — so transcription and burn-in may take a while. The Tiny speech model is the fastest choice.</string>

    <!-- Transcription background hint -->
    <string name="editor_transcribing_background_hint">You can leave this screen — transcription continues in the background.</string>

